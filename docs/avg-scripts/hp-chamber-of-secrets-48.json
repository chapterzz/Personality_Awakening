  "nodes": {
    "welcome": {
      "kind": "dialogue",
      "chapter": "EI",
      "background_key": "welcome",
      "lines": [
        {
          "speaker": "narrator",
          "text": "暑假的最后几天，你在深圳市福田区的家里收拾行李。窗外是熟悉的街道，但明天，你就要踏上前往霍格沃茨的旅程了..."
        },
        {
          "speaker": "sprite",
          "text": "emma，猫头鹰送来了霍格沃茨的信！你的魔法旅程要开始了。"
        }
      ],
      "next_id": "q01_ei"
    },
    "q01_ei": {
      "kind": "choice",
      "chapter": "EI",
      "background_key": "q01_ei",
      "lines": [
        {
          "speaker": "narrator",
          "text": "深圳市福田区的家，出发前一晚。你在收拾行李，手机不断震动。"
        }
      ],
      "options": [
        {
          "id": "q01_ei_opt_a",
          "label": "给朋友们发消息，兴奋讨论新学期",
          "next_id": "transition_diagon_alley",
          "dimension": "EI",
          "side": "E",
          "weight": 3
        },
        {
          "id": "q01_ei_opt_b",
          "label": "独自整理行李，在心里默默期待",
          "next_id": "transition_diagon_alley",
          "dimension": "EI",
          "side": "I",
          "weight": 3
        }
      ]
    },
    "transition_diagon_alley": {
      "kind": "dialogue",
      "chapter": "EI",
      "background_key": "transition_diagon_alley",
      "lines": [
        {
          "speaker": "narrator",
          "text": "你来到了对角巷，这里到处都是神奇的店铺和熙熙攘攘的巫师。"
        },
        {
          "speaker": "sprite",
          "text": "emma！这边！"
        },
        {
          "speaker": "sprite",
          "text": "罗恩兴奋地朝你挥手，赫敏抱着一摞书走过来：'你也来买开学用品吗？我们一起逛吧！'"
        }
      ],
      "next_id": "q02_ei"
    },
    "q02_ei": {
      "kind": "choice",
      "chapter": "EI",
      "background_key": "q02_ei",
      "lines": [
        {
          "speaker": "narrator",
          "text": "对角巷，买完课本后大家要去弗洛林冷饮店。"
        }
      ],
      "options": [
        {
          "id": "q02_ei_opt_a",
          "label": "提议一起去，边喝边聊",
          "next_id": "transition_platform",
          "dimension": "EI",
          "side": "E",
          "weight": 2
        },
        {
          "id": "q02_ei_opt_b",
          "label": "说想先去书店逛逛",
          "next_id": "transition_platform",
          "dimension": "EI",
          "side": "I",
          "weight": 2
        }
      ]
    },
    "transition_platform": {
      "kind": "dialogue",
      "chapter": "EI",
      "background_key": "transition_platform",
      "lines": [
        {
          "speaker": "narrator",
          "text": "9¾站台上，红色的霍格沃茨特快列车喷着白色的蒸汽，像是在召唤你踏上新的旅程。"
        },
        {
          "speaker": "sprite",
          "text": "一个棕色卷发的女孩朝你跑来：'emma！我占了一个包厢，快来！'赫敏拉着你的手，眼睛亮晶晶的。"
        }
      ],
      "next_id": "q03_ei"
    },
    "q03_ei": {
      "kind": "choice",
      "chapter": "EI",
      "background_key": "q03_ei",
      "lines": [
        {
          "speaker": "narrator",
          "text": "霍格沃茨特快，你可以选择坐哪里。"
        }
      ],
      "options": [
        {
          "id": "q03_ei_opt_a",
          "label": "去热闹车厢认识新同学",
          "next_id": "transition_sorting",
          "dimension": "EI",
          "side": "E",
          "weight": 2
        },
        {
          "id": "q03_ei_opt_b",
          "label": "找个安静包厢看书看风景",
          "next_id": "transition_sorting",
          "dimension": "EI",
          "side": "I",
          "weight": 2
        }
      ]
    },
    "transition_sorting": {
      "kind": "dialogue",
      "chapter": "EI",
      "background_key": "transition_sorting",
      "lines": [
        {
          "speaker": "narrator",
          "text": "霍格沃茨的大厅比想象中更加宏伟，成千上万支蜡烛漂浮在空中，照亮了天花板上变幻的星空。"
        },
        {
          "speaker": "sprite",
          "text": "一顶破旧的帽子开始唱歌"
        }
      ],
      "next_id": "q04_ei"
    },
    "q04_ei": {
      "kind": "choice",
      "chapter": "EI",
      "background_key": "q04_ei",
      "lines": [
        {
          "speaker": "narrator",
          "text": "分院仪式开始了，大厅里坐满了新生，旁边有个紧张的男孩。"
        }
      ],
      "options": [
        {
          "id": "q04_ei_opt_a",
          "label": "主动跟他聊天，缓解紧张",
          "next_id": "sorting_hat_emma",
          "dimension": "EI",
          "side": "E",
          "weight": 2
        },
        {
          "id": "q04_ei_opt_b",
          "label": "安静等待，在心里默默准备",
          "next_id": "sorting_hat_emma",
          "dimension": "EI",
          "side": "I",
          "weight": 2
        }
      ]
    },
    "sorting_hat_emma": {
      "kind": "dialogue",
      "chapter": "EI",
      "background_key": "sorting_hat_emma",
      "lines": [
        {
          "speaker": "narrator",
          "text": "终于轮到你了。分院帽被轻轻放在你头上，它裂开嘴开始低语..."
        },
        {
          "speaker": "sprite",
          "text": "'嗯...勇敢、忠诚、有冒险精神...毫无疑问——格兰芬多！'分院帽大声喊出你的名字。"
        },
        {
          "speaker": "sprite",
          "text": "格兰芬多长桌爆发出热烈的掌声。赫敏跳了起来，使劲鼓掌：'我就知道！emma，欢迎来到格兰芬多！'哈利也开心地朝你挥手，罗恩笑得合不拢嘴：'太好了，我们四个都在一个学院！'"
        }
      ],
      "next_id": "q05_ei"
    },
    "q05_ei": {
      "kind": "choice",
      "chapter": "EI",
      "background_key": "q05_ei",
      "lines": [
        {
          "speaker": "narrator",
          "text": "刚到格兰芬多公共休息室，大家聚在一起。"
        },
        {
          "speaker": "sprite",
          "text": "哈利笑着对你说：'emma，欢迎来到格兰芬多！弗雷德和乔治说要教我们玩爆炸牌，你来吗？'"
        }
      ],
      "options": [
        {
          "id": "q05_ei_opt_a",
          "label": "加入玩爆炸牌，认识更多人",
          "next_id": "q06_ei",
          "dimension": "EI",
          "side": "E",
          "weight": 1
        },
        {
          "id": "q05_ei_opt_b",
          "label": "坐在壁炉边安静观察",
          "next_id": "q06_ei",
          "dimension": "EI",
          "side": "I",
          "weight": 1
        }
      ]
    },
    "q06_ei": {
      "kind": "choice",
      "chapter": "EI",
      "background_key": "q06_ei",
      "lines": [
        {
          "speaker": "narrator",
          "text": "洛哈特的第一课，分组练习。"
        }
      ],
      "options": [
        {
          "id": "q06_ei_opt_a",
          "label": "主动邀请不太熟的同学",
          "next_id": "q07_ei",
          "dimension": "EI",
          "side": "E",
          "weight": 2
        },
        {
          "id": "q06_ei_opt_b",
          "label": "等别人来找你，或找熟悉朋友",
          "next_id": "q07_ei",
          "dimension": "EI",
          "side": "I",
          "weight": 2
        }
      ]
    },
    "q07_ei": {
      "kind": "choice",
      "chapter": "EI",
      "background_key": "q07_ei",
      "lines": [
        {
          "speaker": "narrator",
          "text": "走廊里遇到皮皮鬼在捣乱。"
        }
      ],
      "options": [
        {
          "id": "q07_ei_opt_a",
          "label": "跟他斗嘴，看看谁更厉害",
          "next_id": "q08_ei",
          "dimension": "EI",
          "side": "E",
          "weight": 1
        },
        {
          "id": "q07_ei_opt_b",
          "label": "悄悄绕路躲开",
          "next_id": "q08_ei",
          "dimension": "EI",
          "side": "I",
          "weight": 1
        }
      ]
    },
    "q08_ei": {
      "kind": "choice",
      "chapter": "EI",
      "background_key": "q08_ei",
      "lines": [
        {
          "speaker": "narrator",
          "text": "草药课给曼德拉草换盆，搭档合作。"
        },
        {
          "speaker": "sprite",
          "text": "斯普劳特教授朝你点点头：'emma，你和纳威一组吧，曼德拉草虽然脾气不好，但你们一定能照顾好它们。记住，换盆时要戴好耳罩！'"
        }
      ],
      "options": [
        {
          "id": "q08_ei_opt_a",
          "label": "边干活边跟搭档讨论植物特性",
          "next_id": "q09_ei",
          "dimension": "EI",
          "side": "E",
          "weight": 3
        },
        {
          "id": "q08_ei_opt_b",
          "label": "专注操作，用行动多于言语",
          "next_id": "q09_ei",
          "dimension": "EI",
          "side": "I",
          "weight": 3
        }
      ]
    },
    "q09_ei": {
      "kind": "choice",
      "chapter": "EI",
      "background_key": "q09_ei",
      "lines": [
        {
          "speaker": "narrator",
          "text": "走廊壁画里的人在开茶会，邀请路人。"
        }
      ],
      "options": [
        {
          "id": "q09_ei_opt_a",
          "label": "停下来加入聊几句",
          "next_id": "q10_ei",
          "dimension": "EI",
          "side": "E",
          "weight": 1
        },
        {
